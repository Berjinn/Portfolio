@model PortfolioProfile
<section id="projects" class="projects container" aria-labelledby="projects-title"><div class="section-heading"><p class="section-label">04 / Selected work</p><h2 id="projects-title">Projects  I've  Worked  On.</h2></div><div class="project-list">@for (var index = 0; index < Model.Projects.Count; index++) { var project = Model.Projects[index]; var projectUrl = project.LiveUrl ?? project.RepositoryUrl; <article class="project-card"><div class="project-number mono">@((index + 1).ToString("D2"))</div><div><h3>@project.Name</h3><p class="project-description">@project.Description</p><ul class="project-tech">@foreach (var technology in project.Technologies) { <li>@technology</li> }</ul></div>@if (projectUrl is not null) { <a class="project-link" href="@projectUrl" target="_blank" rel="noreferrer" aria-label="Open @project.Name">↗</a> }</article> }</div></section>
