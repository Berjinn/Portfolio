@model PortfolioProfile
<section id="about" class="about container section-grid" aria-labelledby="about-title"><div><p class="section-label">02 / Skills</p><h2 id="about-title">The tools I use to build dependable software.</h2></div><div class="about-details"><p class="mono">@Model.Location</p><div class="skill-groups" aria-label="Technical skills">@foreach (var skillGroup in Model.Skills) { <div class="skill-group"><span>@skillGroup.Category</span><p>@string.Join(" · ", skillGroup.Items)</p></div> }</div><div class="social-links">@if (Model.Contact.GitHubUrl is not null) { <a href="@Model.Contact.GitHubUrl" target="_blank" rel="noreferrer">GitHub ↗</a> } @if (Model.Contact.LinkedInUrl is not null) { <a href="@Model.Contact.LinkedInUrl" target="_blank" rel="noreferrer">LinkedIn ↗</a> }</div></div></section>
